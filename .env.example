# LLM: any OpenAI-compatible API. Free options: gemini (aistudio.google.com/apikey), groq (console.groq.com),
# cerebras (cloud.cerebras.ai), openrouter (openrouter.ai). Leave LLM_MODEL blank for the preset default.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_MODEL=
# Extra providers: any with a key set becomes a fallback when the main provider's daily quota is used up
GEMINI_API_KEY=
CEREBRAS_API_KEY=
# Groq key is also used for the job digest's web search (Groq-only tool)
GROQ_API_KEY=

# Sendblue (SMS/iMessage)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
# Path secret for the inbound webhook URL: POST /webhooks/sendblue/<secret>
SENDBLUE_WEBHOOK_SECRET=

# Your phone, E.164. Only texts from this number are accepted.
MY_PHONE=+15124917035
MY_NAME=

# Gmail: put the OAuth client json at credentials/gmail_client_secret.json, then run scripts/auth_gmail.py
GMAIL_ENABLED=true
# Either save the downloaded client JSON at credentials/gmail_client_secret.json, or paste the client here
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Outlook: register an app in Entra ID (public client, device code flow), then run scripts/auth_outlook.py
OUTLOOK_ENABLED=true
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common

POLL_INTERVAL_SECONDS=1800
# Local hours during which the inbox is not scanned (start inclusive, end exclusive)
QUIET_START_HOUR=22
QUIET_END_HOUR=7
DB_PATH=agent.db
PORT=8000

# Morning job digest (new grad SWE + PM), emailed from Gmail to JOBS_DIGEST_TO (default: your Gmail)
JOBS_DIGEST_ENABLED=true
# Local hours to run the digest + outreach (comma-separated)
JOBS_DIGEST_HOURS=7,19
JOBS_DIGEST_TO=
# Your resume (pdf, docx or txt); summarized into a profile for job ranking and email drafting
RESUME_PATH=credentials/resume.pdf
# Optional one-liner that overrides the resume summary, e.g. "wants APM or SWE roles in NYC/SF only"
JOBS_PROFILE=
# Appended to the resume profile when ranking jobs and choosing outreach targets
JOBS_PREFERENCES=
# Founder / hiring-manager cold outreach: drafts per day, follow-up days after sending, optional Hunter.io key for finding emails
OUTREACH_ENABLED=true
OUTREACH_PER_DAY=3
OUTREACH_FOLLOWUP_DAYS=4,9
HUNTER_API_KEY=
# Supplementary web search on the small model; set false if you hit Groq daily token limits
JOBS_WEB_SEARCH=true
# Drop any posting whose title does not clearly say new grad / entry level / APM / 2026-27 (Simplify feed is trusted)
JOBS_STRICT_NEW_GRAD=true
JOBS_SEARCH_MODEL=openai/gpt-oss-20b
