# Groq (same provider/model as medpull-ortho)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used when the main model hits its per-day token cap (free tier: 200k/day per model)
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Sendblue (SMS/iMessage)
SENDBLUE_API_KEY=
SENDBLUE_API_SECRET=
SENDBLUE_FROM_NUMBER=
# Path secret for the inbound webhook URL: POST /webhooks/sendblue/<secret>
SENDBLUE_WEBHOOK_SECRET=

# Your phone, E.164. Only texts from this number are accepted.
MY_PHONE=+15124917035
MY_NAME=

# Gmail: put the OAuth client json at credentials/gmail_client_secret.json, then run scripts/auth_gmail.py
GMAIL_ENABLED=true
# Either save the downloaded client JSON at credentials/gmail_client_secret.json, or paste the client here
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Outlook: register an app in Entra ID (public client, device code flow), then run scripts/auth_outlook.py
OUTLOOK_ENABLED=true
OUTLOOK_CLIENT_ID=
OUTLOOK_TENANT=common

POLL_INTERVAL_SECONDS=1800
# Local hours during which the inbox is not scanned (start inclusive, end exclusive)
QUIET_START_HOUR=22
QUIET_END_HOUR=7
DB_PATH=agent.db
PORT=8000

# Morning job digest (new grad SWE + PM), emailed from Gmail to JOBS_DIGEST_TO (default: your Gmail)
JOBS_DIGEST_ENABLED=true
JOBS_DIGEST_HOUR=8
JOBS_DIGEST_TO=
# One line about you, used to rank postings, e.g. "Duke CS senior, founder of a health-tech startup, wants APM or SWE roles in NYC/SF"
JOBS_PROFILE=
# Supplementary web search on the small model; set false if you hit Groq daily token limits
JOBS_WEB_SEARCH=true
JOBS_SEARCH_MODEL=openai/gpt-oss-20b
